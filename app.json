{
  "expo": {
    "name": "turtle-tuner",
    "slug": "turtle-tuner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.twsargent.tuner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F368",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Turtle Tuner listens to your instrument to tell you how in tune it is.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "scheme": "turtletuner",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F2F368",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4252dc85-9fde-4711-989c-b380f4cc4dfa"
      }
    }
  }
}
